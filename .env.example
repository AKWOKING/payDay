# PayDay Environment Configuration

PROJECT_NAME="PayDay e-Wallet"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="sqlite+aiosqlite:///./payday.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://payday_user:payday_password@localhost:5432/payday_db"

# Security & JWT Tokens
SECRET_KEY="payday-super-secret-development-key-change-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PII Field Encryption Key (32 bytes AES-256 key, base64 or hex encoded)
ENCRYPTION_KEY="payday_aes256_secret_key_32bytes!"

# CORS Allowed Origins (explicit allowlist — never use "*" with credentials)
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://localhost:8000"]
# Regex for ephemeral preview/sandbox hosts (anchored)
BACKEND_CORS_ORIGIN_REGEX="^https://[a-z0-9-]+\.e2b\.app$"

# Default Limits in XAF
DEFAULT_DAILY_LIMIT=500000.00
DEFAULT_MONTHLY_LIMIT=5000000.00

# Shared counter store (Redis) — WS-0 / WS-3 / WS-5
# COUNTER_BACKEND:
#   "redis"  — shared across replicas (production). Startup fails closed if
#              the configured Redis is unreachable.
#   "memory" — single-process store for local dev/tests ONLY; never use in
#              production (it quietly reintroduces LB-4/LB-6).
COUNTER_BACKEND="memory"
REDIS_URL="redis://localhost:6379/0"
REDIS_REQUIRED=false
# Peers allowed to send X-Forwarded-For for rate-limit IP bucketing
# (empty = header ignored). Example for a single load balancer:
# TRUSTED_PROXY_IPS=["10.0.0.5"]

# Authentication rate limiting (counts login attempts; success resets the
# per-account counter). Windows in seconds.
LOGIN_RATE_LIMIT_PHONE=5
LOGIN_RATE_LIMIT_PHONE_WINDOW=900
LOGIN_RATE_LIMIT_IP=20
LOGIN_RATE_LIMIT_IP_WINDOW=900
REGISTER_RATE_LIMIT_IP=10
REGISTER_RATE_LIMIT_IP_WINDOW=3600
REFRESH_RATE_LIMIT_IP=10
REFRESH_RATE_LIMIT_IP_WINDOW=900

# PIN brute-force lockout (shared counter, TTL in seconds)
PIN_FAILURE_LIMIT=5
PIN_FAILURE_TTL_SECONDS=86400

# --------------------------------------------------------------------------- #
# Telco / mobile-money channels (M1 — LB-8)
# --------------------------------------------------------------------------- #
# TELCO_MODE:
#   "mock"    — deterministic in-process simulator. Default. Used by dev,
#               tests and CI; no network calls, no real money.
#   "sandbox" — real operator sandbox APIs. MTN sandbox credentials are
#               self-provisioned at sandbox.momodeveloper.mtn.com; Orange uses
#               the /dev/ API. Safe to point at real numbers' sandbox.
#   "live"    — real operator production APIs, moving real money.
#
# Startup validation is fail-closed (core/config.py:validate_telco_configuration):
#   * ENVIRONMENT=production + TELCO_MODE=mock  -> refuses to start
#   * TELCO_MODE=live + missing credentials     -> refuses to start, lists them
#   * TELCO_MODE=live + non-public PUBLIC_BASE_URL -> refuses to start
#   * TELCO_MODE=live is not yet enabled at all: operator callback verification
#     is not implemented (task A8), so live mode fails closed by design.
#     See docs/plans/M1_LIVE_MONEY_PATH_PLAN.md.
TELCO_MODE="mock"
TELCO_HTTP_TIMEOUT_SECONDS=15
TELCO_TOKEN_REFRESH_SKEW_SECONDS=300
# Absolute, publicly reachable HTTPS base URL of this API — operator callbacks
# cannot reach localhost or a relative path. Required in live mode.
PUBLIC_BASE_URL="http://localhost:8000"
# Reject an MSISDN whose prefix block belongs to the other operator. Off by
# default: Cameroon has number portability and public prefix tables disagree.
TELCO_STRICT_OPERATOR_PREFIX=false

# XAF has no minor unit. Computed fees are rounded to whole francs at the money
# boundary; which way is a commercial decision, so it is configuration.
# One of: HALF_UP | HALF_EVEN | DOWN | UP
XAF_ROUNDING_MODE="HALF_UP"

# --- MTN MoMo -------------------------------------------------------------- #
# Collections (deposits) and disbursements (withdrawals) use SEPARATE API users,
# keys and subscription keys. Production values are issued by MTN only after
# KYC/vetting on the Partner Portal + a signed contract — there is no public
# production host to guess, so MTN_BASE_URL must be set explicitly in live mode.
# Leave both URLs blank to use the per-mode defaults (mock: none; sandbox:
# https://sandbox.momodeveloper.mtn.com).
MTN_BASE_URL=""
# "sandbox", or the country environment in live/production (Cameroon: mtncameroon).
MTN_TARGET_ENVIRONMENT=""
MTN_COLLECTION_SUBSCRIPTION_KEY=""
MTN_COLLECTION_API_USER=""
MTN_COLLECTION_API_KEY=""
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=""
MTN_DISBURSEMENT_API_USER=""
MTN_DISBURSEMENT_API_KEY=""

# --- Orange Money ---------------------------------------------------------- #
# The OAuth token lives on a DIFFERENT host from the API itself.
ORANGE_TOKEN_URL="https://api.orange.com/oauth/v3/token"
# Blank = per-mode default: sandbox/dev .../orange-money-webpay/dev/v1,
# live .../orange-money-webpay/cm/v1.
ORANGE_BASE_URL=""
# Preferred when Orange supplies a ready-made Basic value. Otherwise set
# ORANGE_CLIENT_ID + ORANGE_CLIENT_SECRET and the adapter base64-encodes them
# (the previous code sent them unencoded, which is not a valid header).
ORANGE_AUTH_HEADER=""
ORANGE_CLIENT_ID=""
ORANGE_CLIENT_SECRET=""
# Requires an RCCM (company registration) from Orange Money Cameroon.
ORANGE_MERCHANT_KEY=""
# Path suffixes differ across Orange API generations and the API is
# mid-migration; configurable so the sandbox run can correct them without a
# code change.
ORANGE_STATUS_PATH="transactionstatus"
ORANGE_PAYOUT_PATH="payout"
