# PayDay Environment Configuration

PROJECT_NAME="PayDay e-Wallet"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="sqlite+aiosqlite:///./payday.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://payday_user:payday_password@localhost:5432/payday_db"

# Security & JWT Tokens
SECRET_KEY="payday-super-secret-development-key-change-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PII Field Encryption Key (32 bytes AES-256 key, base64 or hex encoded)
ENCRYPTION_KEY="payday_aes256_secret_key_32bytes!"

# CORS Allowed Origins (explicit allowlist — never use "*" with credentials)
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://localhost:8000"]
# Regex for ephemeral preview/sandbox hosts (anchored)
BACKEND_CORS_ORIGIN_REGEX="^https://[a-z0-9-]+\.e2b\.app$"

# Default Limits in XAF
DEFAULT_DAILY_LIMIT=500000.00
DEFAULT_MONTHLY_LIMIT=5000000.00

# Shared counter store (Redis) — WS-0 / WS-3 / WS-5
# COUNTER_BACKEND:
#   "redis"  — shared across replicas (production). Startup fails closed if
#              the configured Redis is unreachable.
#   "memory" — single-process store for local dev/tests ONLY; never use in
#              production (it quietly reintroduces LB-4/LB-6).
COUNTER_BACKEND="memory"
REDIS_URL="redis://localhost:6379/0"
REDIS_REQUIRED=false
# Peers allowed to send X-Forwarded-For for rate-limit IP bucketing
# (empty = header ignored). Example for a single load balancer:
# TRUSTED_PROXY_IPS=["10.0.0.5"]

# Authentication rate limiting (counts login attempts; success resets the
# per-account counter). Windows in seconds.
LOGIN_RATE_LIMIT_PHONE=5
LOGIN_RATE_LIMIT_PHONE_WINDOW=900
LOGIN_RATE_LIMIT_IP=20
LOGIN_RATE_LIMIT_IP_WINDOW=900
REGISTER_RATE_LIMIT_IP=10
REGISTER_RATE_LIMIT_IP_WINDOW=3600
REFRESH_RATE_LIMIT_IP=10
REFRESH_RATE_LIMIT_IP_WINDOW=900

# PIN brute-force lockout (shared counter, TTL in seconds)
PIN_FAILURE_LIMIT=5
PIN_FAILURE_TTL_SECONDS=86400
