# Version control
.git
.gitignore

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# Virtual environments
.venv
venv/
env/
ENV/

# Local environment & secrets — never bake into an image
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3

# Tests & docs are not needed in the runtime image
tests/
docs/
*.pdf
*.txt
!requirements*.txt

# IDE
.vscode/
.idea/
*.swp

# CI
.github/

# Build output
build/
dist/
htmlcov/
.coverage
coverage.xml
